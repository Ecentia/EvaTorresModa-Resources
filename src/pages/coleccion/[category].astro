---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { sanityClient } from "sanity:client";
import ProductBrowser from '../../components/ProductBrowser';

export async function getStaticPaths() {
  const categories = await sanityClient.fetch(`*[_type == "category"]{
    "slug": slug.current,
    name,
    description
  }`);

  return categories.map((cat: any) => ({
    params: { category: cat.slug },
    props: { categoryName: cat.name, categoryDesc: cat.description },
  }));
}

const { category } = Astro.params;
const { categoryName, categoryDesc } = Astro.props;

// --- QUERY ACTUALIZADA ---
// 1. Buscamos productos de esta categoría y traemos el nombre de su sección referenciada
// 2. Traemos la configuración de la categoría (si activa filtros o no)
const query = `{
  "products": *[_type == "product" && category->slug.current == $category]{
    name,
    "slug": slug.current,
    price,
    image,
    gender,
    "sectionName": section->name 
  },
  "categorySettings": *[_type == "category" && slug.current == $category][0]{
    enableGenderFilter
  }
}`;

const { products, categorySettings } = await sanityClient.fetch(query, { category });

// Si no hay configuración definida, asumimos true por defecto (o false si prefieres)
const enableGenderFilter = categorySettings?.enableGenderFilter !== false; 
---

<Layout title={`${categoryName} | Colección Eva Torres`}>
    <Header />
    <main class="bg-white min-h-screen">
        
        <section class="bg-eva-dark text-white pt-32 pb-16 relative overflow-hidden">
             <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')]"></div>
             <div class="container mx-auto px-4 relative z-10 text-center">
                <span class="text-eva-gold uppercase tracking-[0.3em] text-xs font-bold mb-4 block animate-fade-in-up">Colección</span>
                <h1 class="text-5xl md:text-6xl font-serif mb-6 animate-fade-in-up" style="animation-delay: 0.1s;">{categoryName}</h1>
                {categoryDesc && (
                    <p class="text-eva-cream/80 max-w-2xl mx-auto font-light text-lg animate-fade-in-up" style="animation-delay: 0.2s;">
                        {categoryDesc}
                    </p>
                )}
             </div>
        </section>

        <section class="py-12 bg-white">
            <div class="container mx-auto px-4">
                
                <ProductBrowser 
                    client:load 
                    products={products} 
                    enableGenderFilter={enableGenderFilter}
                />

                {products.length === 0 && (
                    <div class="text-center py-20 bg-gray-50 rounded-lg border border-dashed border-gray-200 mt-8">
                        <p class="text-gray-500 text-lg font-serif italic">Esta colección está vacía por el momento.</p>
                        <a href="/coleccion" class="inline-block mt-6 text-eva-green font-bold hover:underline">
                            Ver otras colecciones
                        </a>
                    </div>
                )}

            </div>
        </section>

    </main>
    <Footer />
</Layout>